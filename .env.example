# ============================================================
# 鹊桥·红娘工作台 —— 生产环境变量模板
# 用法：复制为 .env（同目录，docker-compose 自动读取），按需修改。
# 所有带 ? 的项为必填，缺失则 compose 启动报错（强制你填写）。
# ============================================================

# ---- 对外 HTTP 端口（云服务器安全组需放行该端口）----
HTTP_PORT=80

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=change-it-root-strong
QUEQIAO_DB_USER=queqiao
QUEQIAO_DB_PASSWORD=change-it-queqiao-strong

# ---- JWT（必填，请用足够随机的长字符串）----
# 生成示例：openssl rand -base64 48
QUEQIAO_JWT_SECRET=replace-with-a-long-random-string

# ---- 请求签名密钥（前后端需一致；前端当前硬编码为 queqiao@2026#sec）----
# 若你改了前端 secret.ts 的 CLIENT_SIGN_SECRET，这里必须改为相同值
QUEQIAO_SIGN_SECRET=queqiao@2026#sec

# ---- 新建账号初始口令（种子/后台建号默认口令，首次登录需改）----
QQ_SEED_PASSWORD=change-it-seed-strong

# ---- CORS 允许的前端源（逗号分隔；用服务器 IP 或域名访问 admin/H5 时填此处）----
# 例：http://1.2.3.4,http://1.2.3.4:80
QQ_CORS_ORIGINS=http://localhost:8080
