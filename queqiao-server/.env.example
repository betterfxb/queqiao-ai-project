# 运行环境：development / test / production
NODE_ENV=development

# HTTP 监听（默认只绑定回环地址，避免公网可达）
HOST=127.0.0.1
PORT=8080

# 数据文件路径（相对当前工作目录或绝对路径）
DB_FILE=./data/db.json
# 写盘节流合并窗口（毫秒）
SAVE_DEBOUNCE_MS=200

# Python AI 服务
AI_BASE=http://localhost:8090
AI_TIMEOUT_MS=5000

# 访问令牌：写操作必须携带 Authorization: Bearer <API_TOKEN> 或 X-API-Token
# 未配置时为本地开发模式（全部放行 + PII 明文），NODE_ENV=production 下未配置将拒绝启动
API_TOKEN=change-me-to-a-long-random-string

# CORS 白名单，逗号分隔；填 * 表示放开（不建议）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 业务时区与请求日志
TZ_NAME=Asia/Shanghai
REQUEST_LOG=true
JSON_LIMIT=256kb
